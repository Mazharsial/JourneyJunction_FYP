# ============================================================
# VoynixAI — Environment Template
# Copy to `.env` and fill in. NEVER commit the real .env.
# ============================================================

# ---- Core / Brand (configurable, no hardcoding) ----
BRAND_NAME=VoynixAI
APP_ENV=development              # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-dev-only-not-a-real-secret

# ---- URLs / CORS ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Database (PostgreSQL only) ----
# Inside docker-compose use host "postgres"; locally use "localhost".
POSTGRES_USER=voynix
POSTGRES_PASSWORD=voynix_dev_password
POSTGRES_DB=voynixai
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Async driver URL (SQLAlchemy). Built from the pieces above if left blank.
DATABASE_URL=

# ---- Redis (cache / Celery broker) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=

# ---- Auth / JWT ----
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_HOURS=2

# ---- Rate limiting (auth endpoints) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# ---- Optional super admin bootstrap (python -m app.db.init_db) ----
# Leave blank to skip. Never commit real values.
SUPERUSER_EMAIL=
SUPERUSER_PASSWORD=

# ---- Default market (configurable; seeded, not hardcoded) ----
DEFAULT_COUNTRY=AE
DEFAULT_CITY=Dubai
DEFAULT_CURRENCY=AED
DEFAULT_LOCALE=en
DEFAULT_TIMEZONE=Asia/Dubai

# ============================================================
# External integrations — added per phase. Leave blank until then.
# The app runs in mock/degraded mode when a key is absent.
# ============================================================

# ---- AI (Google Gemini — free tier) [Phase 6] ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ---- Flights/Hotels (Amadeus Self-Service, free test env) [Phase 5] ----
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test                 # test | production

# ---- Stripe (test mode) [Phase 9] ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ---- Meta WhatsApp Cloud API [Phase 8] ----
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ---- Klaviyo (email) [Phase 8] ----
KLAVIYO_API_KEY=

# ---- Maps (optional) ----
GOOGLE_MAPS_API_KEY=
